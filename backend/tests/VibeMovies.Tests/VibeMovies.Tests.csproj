<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Versões alinhadas com o cache NuGet local (ambiente offline). Os testes usam SQLite em memória
    (Microsoft.EntityFrameworkCore.Sqlite 9.x, herdado da Infrastructure) em vez do provider InMemory,
    e sobem a API real em Kestrel (porta efêmera em 127.0.0.1) em vez do WebApplicationFactory.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VibeMovies.Domain\VibeMovies.Domain.csproj" />
    <ProjectReference Include="..\..\src\VibeMovies.Application\VibeMovies.Application.csproj" />
    <ProjectReference Include="..\..\src\VibeMovies.Infrastructure\VibeMovies.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\VibeMovies.Api\VibeMovies.Api.csproj" />
  </ItemGroup>

</Project>
