<Window x:Class="VibeMovies.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎬 VibeMovies Desktop — Buscador por Vibe &amp; Rastreador de Filmes"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#090A0F"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== HEADER BAR ==================== -->
        <Border Grid.Row="0"
                Background="#10121C"
                BorderBrush="#22263A"
                BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#7C3AED" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                        <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🎬 VibeMovies Desktop — Buscador por Vibe &amp; Rastreador de Filmes"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC" />
                        <TextBlock x:Name="SubtitleStatusText"
                                   Text="Curadoria Inteligente • JustWatch Brasil (Streamings) • Radar de Cinemas Locais"
                                   FontSize="11.5"
                                   Foreground="#94A3B8"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="NavExploreBtn"
                            Content="✨ Explorar por Vibe"
                            Click="NavExploreBtn_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button x:Name="NavRadarBtn"
                            Content="📡 Radar de Cinemas Locais"
                            Click="NavRadarBtn_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button x:Name="NavWatchlistBtn"
                            Content="📓 Diário de Bordo (Watchlist)"
                            Click="NavWatchlistBtn_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <!-- Top-Right Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnTmdbKey"
                            Content="🔑 Chave TMDB API"
                            Click="BtnTmdbKey_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0" />

                    <Button x:Name="BtnUserProfile"
                            Content="👤 Cinéfilo Vibe (demo@vibemovies.app)"
                            Click="BtnUserProfile_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="1">

            <!-- ==================== VIEW 1: EXPLORAR POR VIBE ==================== -->
            <ScrollViewer x:Name="ViewExplore"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Visible"
                          Padding="24,18">
                <StackPanel MaxWidth="1380">
                    <!-- Section Header -->
                    <Border Background="#12141F"
                            BorderBrush="#23273D"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20,16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="QUAL É A SUA VIBE HOJE?"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="#A855F7" />
                                    <TextBlock Text="Selecione uma ou mais atmosferas cinematográficas para cruzar Keywords e Metadados do TMDB"
                                               FontSize="13"
                                               Foreground="#94A3B8"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        x:Name="ApiModeBadge"
                                        Background="#132A23"
                                        BorderBrush="#10B981"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ApiModeBadgeText"
                                               Text="⚡ Catálogo Curado + JustWatch BR"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#10B981" />
                                </Border>
                            </Grid>

                            <!-- Interactive Vibe Chips WrapPanel -->
                            <WrapPanel x:Name="VibeChipsPanel" Margin="0,4,0,12" />

                            <!-- Filter Bar -->
                            <Border Background="#0D0F18"
                                    BorderBrush="#1F2437"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,12">
                                <WrapPanel VerticalAlignment="Center">
                                    <!-- Genre ComboBox -->
                                    <StackPanel Margin="0,0,14,6">
                                        <TextBlock Text="Gênero" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <ComboBox x:Name="GenreComboBox"
                                                  Width="190"
                                                  Height="34"
                                                  SelectionChanged="FilterCombo_SelectionChanged" />
                                    </StackPanel>

                                    <!-- Max Runtime ComboBox -->
                                    <StackPanel Margin="0,0,14,6">
                                        <TextBlock Text="Duração Máxima" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <ComboBox x:Name="RuntimeComboBox"
                                                  Width="165"
                                                  Height="34"
                                                  SelectionChanged="FilterCombo_SelectionChanged" />
                                    </StackPanel>

                                    <!-- Streaming Provider ComboBox -->
                                    <StackPanel Margin="0,0,14,6">
                                        <TextBlock Text="Streaming (BR)" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <ComboBox x:Name="StreamingComboBox"
                                                  Width="185"
                                                  Height="34"
                                                  SelectionChanged="FilterCombo_SelectionChanged" />
                                    </StackPanel>

                                    <!-- Search TextBox -->
                                    <StackPanel Margin="0,0,14,6">
                                        <TextBlock Text="Busca por Título, Diretor ou Tema" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <TextBox x:Name="SearchTextBox"
                                                 Width="250"
                                                 Height="34"
                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                 KeyDown="SearchTextBox_KeyDown" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                        <Button Content="🔎 Filtrar"
                                                Click="BtnApplySearch_Click"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="34"
                                                Margin="0,0,8,0" />
                                        <Button Content="🧹 Limpar Filtros"
                                                Click="BtnClearFilters_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="34" />
                                    </StackPanel>
                                </WrapPanel>
                            </Border>

                            <!-- Formula Banner -->
                            <Border Background="#161329"
                                    BorderBrush="#4C1D95"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,12,0,0">
                                <DockPanel>
                                    <TextBlock Text="🧪 Fórmula TMDB:"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="#C4B5FD"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ResultCountLabel"
                                               DockPanel.Dock="Right"
                                               Text="0 filmes encontrados"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#10B981"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                    <TextBlock x:Name="FormulaSummaryText"
                                               Text="Carregando heurística de descoberta..."
                                               FontSize="12"
                                               Foreground="#E2E8F0"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Movies WrapPanel -->
                    <WrapPanel x:Name="MoviesCardsPanel"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== VIEW 2: RADAR DE CINEMAS LOCAIS ==================== -->
            <ScrollViewer x:Name="ViewRadar"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed"
                          Padding="24,18">
                <StackPanel MaxWidth="1380">
                    <Border Background="#12141F"
                            BorderBrush="#23273D"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20,16"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="📡 RADAR DE CINEMAS LOCAIS &amp; SESSÕES EM CARTAZ"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#10B981" />
                            <TextBlock Text="Cruzamento dos filmes 'Now Playing' (TMDB) com extração DOM (HtmlAgilityPack) das redes locais de cinema"
                                       FontSize="13"
                                       Foreground="#94A3B8"
                                       Margin="0,3,0,12" />

                            <!-- Quick City Buttons -->
                            <TextBlock Text="Cidades com Cobertura Rápida:"
                                       FontSize="11.5"
                                       Foreground="#94A3B8"
                                       Margin="0,0,0,6" />
                            <WrapPanel x:Name="CityButtonsPanel" Margin="0,0,0,12" />

                            <!-- Custom City Input -->
                            <WrapPanel VerticalAlignment="Center">
                                <TextBox x:Name="CustomCityTextBox"
                                         Width="260"
                                         Height="36"
                                         Text="Joinville/SC"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Margin="0,0,10,0" />
                                <Button Content="📡 Buscar Programação"
                                        Click="BtnSearchRadar_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="36" />
                            </WrapPanel>

                            <!-- Scraper Source Info Banner -->
                            <Border Background="#0D1F1C"
                                    BorderBrush="#059669"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,12,0,0">
                                <DockPanel>
                                    <TextBlock x:Name="RadarTimestampText"
                                               DockPanel.Dock="Right"
                                               Text=""
                                               FontSize="11.5"
                                               Foreground="#6EE7B7"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="RadarSourceText"
                                               Text="HtmlAgilityPack DOM Parser • Programação Local"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#A7F3D0"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Radar Movies List -->
                    <StackPanel x:Name="RadarMoviesPanel" />
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== VIEW 3: DIÁRIO DE BORDO (WATCHLIST) ==================== -->
            <ScrollViewer x:Name="ViewWatchlist"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed"
                          Padding="24,18">
                <StackPanel MaxWidth="1380">
                    <!-- 4 Stat Cards -->
                    <UniformGrid Columns="4" Margin="0,0,0,18">
                        <Border Background="#12141F" BorderBrush="#23273D" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="✅ FILMES ASSISTIDOS (JÁ VI)" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                <TextBlock x:Name="StatWatchedCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,6,0,2" />
                                <TextBlock Text="Avaliados no seu diário" FontSize="11.5" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Background="#12141F" BorderBrush="#23273D" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="📌 NA FILA (QUERO VER)" FontSize="11" FontWeight="Bold" Foreground="#A855F7" />
                                <TextBlock x:Name="StatWantCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,6,0,2" />
                                <TextBlock Text="Salvos para a próxima sessão" FontSize="11.5" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Background="#12141F" BorderBrush="#23273D" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="★ SUA NOTA MÉDIA" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                <TextBlock x:Name="StatAvgRating" Text="0.0 ★" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,2" />
                                <TextBlock Text="Média das avaliações pessoais (1 a 5)" FontSize="11.5" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Background="#12141F" BorderBrush="#23273D" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="⏱️ TEMPO TOTAL DE TELA" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                <TextBlock x:Name="StatTotalTime" Text="0h 0min" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,6,0,2" />
                                <TextBlock x:Name="StatMinutesSub" Text="0 minutos de cinema" FontSize="11.5" Foreground="#64748B" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Watchlist Filter Sub-tabs -->
                    <Border Background="#12141F"
                            BorderBrush="#23273D"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,16">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="BtnFilterAll"
                                        Content="📚 Todos"
                                        Click="BtnWatchlistFilter_Click"
                                        Tag="All"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,8,0" />
                                <Button x:Name="BtnFilterWatched"
                                        Content="✅ Já Vi (Avaliados)"
                                        Click="BtnWatchlistFilter_Click"
                                        Tag="Watched"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0" />
                                <Button x:Name="BtnFilterWant"
                                        Content="📌 Quero Ver"
                                        Click="BtnWatchlistFilter_Click"
                                        Tag="WantToWatch"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>

                            <TextBlock x:Name="WatchlistCountText"
                                       DockPanel.Dock="Right"
                                       Text="4 registros"
                                       FontSize="12.5"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>

                    <!-- Watchlist Items Container -->
                    <StackPanel x:Name="WatchlistItemsPanel" />
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== MODAL OVERLAYS ==================== -->
            <Grid x:Name="ModalBackdrop"
                  Background="#CC05060A"
                  Visibility="Collapsed">

                <!-- 1. Rating / Notes Modal (Já Vi / Avaliar) -->
                <Border x:Name="RatingModalCard"
                        Visibility="Collapsed"
                        Width="520"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="#12141F"
                        BorderBrush="#7C3AED"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="✅ REGISTRAR NO DIÁRIO DE BORDO (JÁ VI)"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#10B981" />
                        <TextBlock x:Name="RatingModalMovieTitle"
                                   Text="Título do Filme"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,14" />

                        <TextBlock Text="Sua Nota Pessoal (1 a 5 Estrelas):"
                                   FontSize="12.5"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,8" />
                        <StackPanel x:Name="RatingStarsPanel"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,16" />

                        <TextBlock Text="Suas Anotações / Crítica Pessoal:"
                                   FontSize="12.5"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="RatingNotesTextBox"
                                 Height="100"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Margin="0,0,0,18" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar"
                                    Click="BtnCloseModal_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,10,0" />
                            <Button Content="💾 Salvar Avaliação"
                                    Click="BtnSaveRating_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Movie Details Modal -->
                <Border x:Name="DetailsModalCard"
                        Visibility="Collapsed"
                        Width="720"
                        MaxHeight="760"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="#12141F"
                        BorderBrush="#3B82F6"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right"
                                        Content="✖ Fechar"
                                        Click="BtnCloseModal_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <StackPanel>
                                    <TextBlock x:Name="DetailsTitleText"
                                               Text="Título do Filme"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#F8FAFC"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailsSubtitleText"
                                               Text="Original Title • 2020 • 130 min • ★ 8.2"
                                               FontSize="13"
                                               Foreground="#94A3B8"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Border Background="#181B2C" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                <TextBlock x:Name="DetailsOverviewText"
                                           Text="Sinopse completa..."
                                           FontSize="13.5"
                                           LineHeight="20"
                                           Foreground="#E2E8F0"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#161928" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="🎬 Direção &amp; Elenco Principal" FontSize="11.5" FontWeight="Bold" Foreground="#A855F7" />
                                        <TextBlock x:Name="DetailsDirectorText" Text="Diretor: -" FontSize="12.5" Foreground="#F8FAFC" Margin="0,6,0,2" TextWrapping="Wrap" />
                                        <TextBlock x:Name="DetailsCastText" Text="Elenco: -" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#161928" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🏷️ Gêneros &amp; Keywords TMDB" FontSize="11.5" FontWeight="Bold" Foreground="#10B981" />
                                        <TextBlock x:Name="DetailsGenresText" Text="Gêneros: -" FontSize="12.5" Foreground="#F8FAFC" Margin="0,6,0,2" TextWrapping="Wrap" />
                                        <TextBlock x:Name="DetailsKeywordsText" Text="Keywords: -" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#131B2E" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="📺 ONDE ASSISTIR NO BRASIL (JUSTWATCH / TMDB WATCH PROVIDERS)"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="#60A5FA"
                                               Margin="0,0,0,6" />
                                    <TextBlock x:Name="DetailsProvidersText"
                                               Text="Carregando disponibilidade..."
                                               FontSize="12.5"
                                               Foreground="#E2E8F0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 3. TMDB API Key Modal -->
                <Border x:Name="TmdbKeyModalCard"
                        Visibility="Collapsed"
                        Width="500"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="#12141F"
                        BorderBrush="#F59E0B"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="🔑 CONFIGURAR CHAVE DA API TMDB (OPCIONAL)"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#F59E0B" />
                        <TextBlock Text="O VibeMovies já funciona 100% offline/local com seu catálogo curado de alta precisão. Caso possua uma API Key v3 ou Read Access Token v4 do TMDB, informe abaixo para consultar a API ao vivo:"
                                   FontSize="12.5"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,14" />

                        <TextBlock Text="TMDB API Key (v3) ou Bearer Token (v4):"
                                   FontSize="12"
                                   Foreground="#E2E8F0"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="TmdbApiKeyTextBox"
                                 Height="36"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 Margin="0,0,0,18" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Usar Catálogo Curado (Limpar)"
                                    Click="BtnClearTmdbKey_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="Cancelar"
                                    Click="BtnCloseModal_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="✅ Aplicar Chave"
                                    Click="BtnSaveTmdbKey_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. User Auth / Switch Account Modal -->
                <Border x:Name="AuthModalCard"
                        Visibility="Collapsed"
                        Width="480"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="#12141F"
                        BorderBrush="#7C3AED"
                        BorderThickness="1.5"
                        CornerRadius="14"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="👤 CONTA DO USUÁRIO &amp; DIÁRIO DE BORDO"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#A855F7" />
                        <TextBlock x:Name="AuthCurrentStatusText"
                                   Text="Conectado como: Cinéfilo Vibe (demo@vibemovies.app)"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="#10B981"
                                   Margin="0,4,0,14" />

                        <TextBlock Text="Nome (apenas para criar nova conta):" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox x:Name="AuthNameTextBox" Height="34" Text="Cinéfilo Vibe" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="E-mail:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox x:Name="AuthEmailTextBox" Height="34" Text="demo@vibemovies.app" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="Senha:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBox x:Name="AuthPasswordTextBox" Height="34" Text="vibe1234" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,8" />

                        <TextBlock x:Name="AuthFeedbackText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="#F87171"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Fechar"
                                    Click="BtnCloseModal_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="🆕 Criar Conta"
                                    Click="BtnRegisterUser_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="🔐 Entrar"
                                    Click="BtnLoginUser_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== FOOTER STATUS BAR ==================== -->
        <Border Grid.Row="2"
                Background="#0D0F18"
                BorderBrush="#1E2235"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <DockPanel>
                <TextBlock x:Name="FooterDbText"
                           DockPanel.Dock="Left"
                           Text="🗄️ Banco de Dados: SQLite Local (vibemovies_desktop.db)"
                           FontSize="11.5"
                           Foreground="#64748B" />
                <TextBlock x:Name="FooterStatusText"
                           DockPanel.Dock="Right"
                           Text="Pronto • Região: BR (JustWatch / TMDB)"
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
